# =============================================================================
# Example configuration: serverless PrivateLink + Unity Catalog connection to an
# existing Oracle database
# =============================================================================

# AWS region for deployment. Determines the environment: commercial (e.g.
# us-east-1) or GovCloud (us-gov-west-1), and thus which Databricks serverless
# private-connectivity role is allowlisted on the VPC endpoint service.
region = ""

# GovCloud shard: "civilian" or "dod". Required when region is us-gov-west-1;
# leave null (or omit) for commercial regions.
databricks_gov_shard = null

# Prefix used for naming and tagging resources.
resource_prefix = ""

# ---- AWS: NLB + VPC endpoint service ----

# VPC that can reach the Oracle database and where the NLB is created.
vpc_id = ""

# Subnets (one per AZ) for the internal NLB. Use at least two AZs.
nlb_subnet_ids = ["", ""]

# Private IP of the Oracle database the NLB forwards to. For Amazon RDS, find the
# instance's ENI IP (the endpoint DNS name is not resolvable outside the VPC):
#   aws ec2 describe-network-interfaces --filters Name=group-id,Values=<db-sg-id> \
#     --query 'NetworkInterfaces[].PrivateIpAddress'
# NOTE: RDS private IPs can change on failover; re-resolve and re-apply if it moves.
oracle_ip_address = "10.0.1.20"

# Port of the Oracle TCPS (TLS) listener.
oracle_port = 2484

# Optional: port the NLB advertises to serverless compute. Defaults to oracle_port.
# nlb_port = 2484

# Optional: override the allowlisted principals. Defaults to the Databricks
# serverless private-connectivity role for the selected shard. Use ["*"] for the
# simplified allow-all approach from the Databricks docs.
# allowed_principals = ["*"]

# Auto-accept the allowlisted Databricks role so the connection can be created in
# one apply. Set true to accept the endpoint connection manually.
acceptance_required = false

# ---- Databricks ----

databricks_account_id     = ""
databricks_workspace_host = ""

# NCC already bound to the workspace (the main SRA config's ncc_id output).
ncc_id = ""

# ---- Unity Catalog connection ----

# Oracle hostname (e.g. the RDS endpoint address). Must match the server
# certificate's subject, and is registered as the NCC rule's domain name.
oracle_host = "mydb.xxxxxxxxxxxx.us-gov-west-1.rds.amazonaws.com"

oracle_service_name = "ORCL"

# For Lakeflow Connect CDC, a dedicated replication user created by
# dbx_oracle_setup_util (see cdc_setup). Supply the password via the
# TF_VAR_oracle_password environment variable rather than this file.
oracle_user = "DBX_CDC"

# PEM CA chain that signed the Oracle server certificate. For Amazon RDS, the
# regional bundle from https://truststore.pki.rds.amazonaws.com (GovCloud:
# https://truststore.pki.us-gov-west-1.rds.amazonaws.com/us-gov-west-1/us-gov-west-1-bundle.pem).
server_certificate_path = "example_db/rds_setup/rds-ca-rsa4096-g1.pem"

# Optional: Unity Catalog object names.
# connection_name      = "oracle"
# foreign_catalog_name = "oracle"
